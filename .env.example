# Supabase dashboard -> Project Settings -> API (or "API Keys")
# Both values are safe to ship to the browser; Row Level Security protects the data.
# NEVER put the service_role / secret key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Gentle reminders (optional): the PUBLIC half of your reminder keys. Safe in the browser.
# The private half goes ONLY in Supabase → Edge Functions → Secrets (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
